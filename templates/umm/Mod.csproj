<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>$(ModId)</AssemblyName>
    <RootNamespace>$(ModId)</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableModTests Condition="'$(EnableModTests)' == ''">false</EnableModTests>
    <DefineConstants Condition="'$(EnableModTests)' == 'true'">$(DefineConstants);TI_MOD_TESTS</DefineConstants>
    <ManagedDir>$(TerraInvictaDir)/TerraInvicta_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(ManagedDir)/UnityModManager/UnityModManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ManagedDir)/UnityModManager/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="$(ExtraReferencesFile)" Condition="'$(ExtraReferencesFile)' != ''" />
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ModId)' == ''" Text="Build through ti.ps1, or pass -p:ModId=Author.Mod." />
    <Error Condition="'$(TerraInvictaDir)' == ''" Text="Run ti.ps1 setup, then build." />
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" Text="Missing local game reference: %(Reference.HintPath)" />
  </Target>
</Project>
